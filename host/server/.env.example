# Achievements Passport Server Configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Core ---
PORT=3281
HOST=0.0.0.0
DATA_DIR=./data

# Public base URL of the site (used for Steam OpenID return URLs).
# Leave empty to auto-derive from each request (works behind NPM/Cloudflare).
BASE_URL=

# --- Session & secrets ---
# Long random strings (>=32 chars). Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Used to encrypt stored admin credentials at rest (S3 keys, etc.)
ENCRYPTION_SECRET=

# --- Steam ---
# One shared Web API key (create free at https://steamcommunity.com/dev/apikey).
# The server uses this single key to fetch PUBLIC profile data for every user.
STEAM_API_KEY=
# SteamID64 of the site owner (gets the Admin tab + S3 auto-refresh).
OWNER_STEAMID=

# --- Admin login (hardcoded single admin account) ---
ADMIN_USERNAME=MohandL3G
ADMIN_PASSWORD=

# --- Scheduler (default nightly at 00:00) ---
# cron expression, see https://crontab.guru
SCHEDULE_CRON=0 0 * * *
[Unit]
Description=Achievements Passport (Steam OpenID + CloudRedirect + S3 auto-refresh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/achievements-passport/host/server
EnvironmentFile=/opt/achievements-passport/host/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target